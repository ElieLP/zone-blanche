    "build": "vite build"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
